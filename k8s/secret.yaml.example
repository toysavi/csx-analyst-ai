apiVersion: v1
kind: Secret
metadata:
  name: csx-analyst-secrets
  namespace: csx-analyst
type: Opaque
stringData:
  # Replace with your actual Gemini API Key
  GEMINI_API_KEY: "AIzaSy..."
  # Optional: MongoDB URI (Local or Atlas)
  MONGODB_URI: "mongodb://mongo.csx-analyst.svc.cluster.local:27017/csx_analyst"
