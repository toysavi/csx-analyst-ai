# GEMINI_API_KEY: Required for Gemini AI API calls and CSX institutional chat analysis.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# MONGODB_URI: MongoDB connection string (Local, Docker, or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/csx_analyst
# Example Docker: mongodb://mongodb:27017/csx_analyst
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/csx_analyst
MONGODB_URI="mongodb://127.0.0.1:27017/csx_analyst"
MONGODB_DB_NAME="csx_analyst"

# APP_URL: Base host URL (optional)
APP_URL="https://csx.toysavi.com"

# Server Port
PORT=3000
